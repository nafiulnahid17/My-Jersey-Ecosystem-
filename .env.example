# The storefront works without configuration. Admin endpoints stay disabled
# until you set a strong secret here.
PORT=3000
HOST=127.0.0.1
ADMIN_API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=./data/my-jersey.sqlite
TRUST_PROXY=false

# When both values are present, the server uses Supabase instead of SQLite.
# SUPABASE_SECRET_KEY is server-only and must never appear in public/ or Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# When both values are present, the server uses Supabase instead of SQLite.
# SUPABASE_SECRET_KEY is server-only and must never appear in public/ or Git.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
